# Copy to .env and generate fresh secrets; never commit the resulting .env.
IRIS_IMAGE=iris-local:review
IRIS_DATA_PATH=/volume2/docker/iris/data
OPENWA_DATA_PATH=/volume2/docker/iris/openwa
IRIS_SECRET_KEY=
IRIS_ADMIN_USERNAME=admin
IRIS_ADMIN_PASSWORD=
IRIS_METRICS_TOKEN=
IRIS_PUBLIC_BASE_URL=http://nas.example:8182
OPENWA_IMAGE=ghcr.io/rmyndharis/openwa:0.24.0
OPENWA_API_KEY_PEPPER=
IRIS_CLASSIFICATION_PROVIDER=ollama
IRIS_OLLAMA_BASE_URL=http://mac.example:11434
IRIS_OLLAMA_MODEL=qwen3.5:9b-q8_0
IRIS_WHISPER_URL=http://mac.example:8081/v1/audio/transcriptions
# Uncomment this and the corresponding Compose line only for an explicit provider override.
# IRIS_TRANSCRIPTION_PROVIDER=local_whisper
IRIS_WHISPER_API_KEY=
IRIS_WHISPER_MODEL=auto
# Optional language-specific fallback; unset by default.
IRIS_WHISPER_FALLBACK_MODEL=
IRIS_LOCAL_SAFETY_MODE=true
IRIS_WORKERS=1
IRIS_DELIVERY_WORKERS=1
IRIS_JOB_HEARTBEAT_SECONDS=30
IRIS_MONITORING_SILENCE_MINUTES=60
IRIS_REQUIRE_WEBHOOK_SIGNATURES=true
IRIS_AUTO_UPDATE=false
OPENWA_AUTO_UPDATE=false

# Optional automatic QR pairing; both values must be configured.
OPENWA_URL=http://openwa:2785
OPENWA_API_KEY=

# Beta build identity; this does not publish a stable release.
IRIS_BUILD_VERSION=local-providers-beta.1
