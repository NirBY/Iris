# Copy to `.env` in this folder and fill in. `.env` is git-ignored: never commit it.
# Compose reads it automatically for every file here.

# --- Iris (all stacks) ---
# openssl rand -base64 32   (back it up: it encrypts every stored secret)
IRIS_SECRET_KEY=
IRIS_ADMIN_USERNAME=admin
# First run only: the account is created with this password, then the value is ignored.
IRIS_ADMIN_PASSWORD=
# The address OpenWA can reach Iris on. OpenWA refuses webhooks to private (LAN) addresses,
# so use a public hostname (reverse proxy or tunnel), e.g. https://iris.example.com
IRIS_PUBLIC_BASE_URL=
# Published port and image; select the reviewed release tag or immutable digest.
IRIS_PORT=8080
IRIS_IMAGE=
# Recommended when the port is reachable beyond this machine: /metrics then needs
# `Authorization: Bearer <token>`. Leave empty to keep /metrics open.
IRIS_METRICS_TOKEN=

# --- mysql.yml / postgres.yml ---
# Letters and digits only: the value goes into a connection URL without escaping.
# For example: openssl rand -hex 24
DB_PASSWORD=

# --- openwa.yml ---
OPENWA_PORT=2785
TZ=UTC

# Pin the tested gateway, for example ghcr.io/rmyndharis/openwa@sha256:<digest>.
OPENWA_IMAGE=
