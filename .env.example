# Bootstrap settings (IRIS_ prefix). Copy to .env and fill in.

# 32-byte key, base64 encoded (e.g. `openssl rand -base64 32`). Encrypts secrets at rest.
IRIS_SECRET_KEY=
# Initial admin user, used on first run only.
IRIS_ADMIN_USERNAME=
IRIS_ADMIN_PASSWORD=
# Public domain URL for alert/media/webhook links (e.g. https://iris.example.com).
# Editable in Settings > Alerts > Iris base URL; saved setting overrides this default.
IRIS_PUBLIC_BASE_URL=
# Optional separate address allowed and reachable from OpenWA for webhooks.
# IRIS_WEBHOOK_BASE_URL=http://192.0.2.10:8182
# Optional overrides
# IRIS_DATA_DIR=/data
# IRIS_PORT=8080
# IRIS_WORKERS=3
# Bound handler attempts even when lease heartbeats are enabled.
# IRIS_JOB_TIMEOUT_SECONDS=900
# IRIS_JOB_HEARTBEAT_SECONDS=30
# Require signing for manually configured instances too (configure gateway secrets first).
# IRIS_REQUIRE_WEBHOOK_SIGNATURES=true
# IRIS_LOG_LEVEL=INFO
# IRIS_LOG_JSON=false
# Optional: require `Authorization: Bearer <token>` on /metrics
# IRIS_METRICS_TOKEN=
# Optional: your reverse proxy's IP, so the login rate limit sees real client addresses
# IRIS_FORWARDED_ALLOW_IPS=127.0.0.1

# Test-only: used by `pytest -m integration` and local dev seeding.
TEST_OPENAI_API_KEY=
TEST_CLOUDFLARE_ACCOUNT_ID=
TEST_CLOUDFLARE_API_TOKEN=
TEST_OPENWA_BASE_URL=
TEST_OPENWA_API_KEY=
TEST_OPENWA_INSTANCE_A=
TEST_OPENWA_INSTANCE_B=
TEST_ALERT_RECIPIENT=

# Emergency recovery is available only via the container CLI, never HTTP login.
# Set a long random key (32+ characters) and store a copy offline.
IRIS_TWO_FACTOR_RECOVERY_KEY=

# Alert notifications: portal settings take precedence after initial setup.
# SMTP and GreenAPI require a successful provider test before activation.
IRIS_ALERT_CHANNEL=openwa
IRIS_ALERT_RECIPIENTS=
IRIS_TELEGRAM_BOT_TOKEN=
IRIS_TELEGRAM_CHAT_ID=
IRIS_GREENAPI_API_URL=https://api.green-api.com
IRIS_GREENAPI_MEDIA_URL=https://media.green-api.com
IRIS_GREENAPI_INSTANCE_ID=
IRIS_GREENAPI_TOKEN=
IRIS_SMTP_HOST=
IRIS_SMTP_PORT=587
IRIS_SMTP_TLS=starttls
IRIS_SMTP_USERNAME=
IRIS_SMTP_PASSWORD=
IRIS_SMTP_SENDER=
