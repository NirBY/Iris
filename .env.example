# Bootstrap settings (IRIS_ prefix). Copy to .env and fill in.

# 32-byte key, base64 encoded (e.g. `openssl rand -base64 32`). Encrypts secrets at rest.
IRIS_SECRET_KEY=
# Initial admin user, used on first run only.
IRIS_ADMIN_USERNAME=
IRIS_ADMIN_PASSWORD=
# Externally reachable base URL, used to build webhook URLs (e.g. http://10.0.0.20:8080).
IRIS_PUBLIC_BASE_URL=
# Optional overrides
# IRIS_DATA_DIR=/data
# IRIS_PORT=8080
# IRIS_WORKERS=3
# IRIS_LOG_LEVEL=INFO
# IRIS_LOG_JSON=false

# Test-only: used by `pytest -m integration` and local dev seeding.
TEST_OPENAI_API_KEY=
TEST_CLOUDFLARE_ACCOUNT_ID=
TEST_CLOUDFLARE_API_TOKEN=
TEST_OPENWA_BASE_URL=
TEST_OPENWA_API_KEY=
TEST_OPENWA_INSTANCE_A=
TEST_OPENWA_INSTANCE_B=
TEST_ALERT_RECIPIENT=
